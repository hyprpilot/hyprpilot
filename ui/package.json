{
  "name": "hyprpilot-ui",
  "version": "2.3.0",
  "description": "Vue 3 + Tailwind frontend for the hyprpilot Tauri overlay.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "VITE_HYPRPILOT_DEV_PREVIEW=1 vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write src/ --log-level warn && eslint --fix",
    "lint": "eslint && vue-tsc --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@shikijs/transformers": "^4.0.2",
    "@tanstack/vue-query": "^5.100.10",
    "@tanstack/vue-virtual": "^3.13.24",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@vueuse/core": "^14.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.4",
    "focus-trap-vue": "^4.1.0",
    "markdown-it": "^14.1.1",
    "markdown-it-task-lists": "^2.1.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "shiki": "^4.0.2",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/vue": "^8.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.6",
    "@vue/test-utils": "^2.4.10",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  }
}
