[Unit]
Description=hyprpilot — Tauri overlay daemon for agent-driven workflows
Documentation=https://github.com/hyprpilot/hyprpilot

[Service]
Type=simple
# --hidden boots the overlay invisible; first user-visible map is the
# Hyprland keybind / tray click / `hyprpilot ctl overlay show`.
ExecStart=/usr/bin/hyprpilot daemon --hidden
Restart=on-failure
RestartSec=5
# Hardening — the daemon is captain-scoped (unix socket under
# $XDG_RUNTIME_DIR), so no system-wide access is needed.
PrivateTmp=true
ProtectSystem=strict
# ProtectHome is INTENTIONALLY NOT set — the daemon spawns agents
# that read + write arbitrary files under $HOME (the captain's
# projects, notes, dotfiles, anywhere the resolved profile's `cwd`
# lands). A `read-only` or `tmpfs` value here breaks every write a
# code-editing agent attempts, with errors that surface as cryptic
# permission failures inside the agent's tool calls. The unix
# socket + Tauri overlay are the captain's actual security boundary;
# the daemon's privilege model is "trust the captain's agents".
ReadWritePaths=%t %h/.config/hyprpilot %h/.local/state/hyprpilot %h/.local/share/hyprpilot

[Install]
WantedBy=default.target
