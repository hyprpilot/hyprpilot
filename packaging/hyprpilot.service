[Unit]
Description=hyprpilot — An overlay daemon that runs coding agents at the edge of your screen.
Documentation=https://github.com/hyprpilot/hyprpilot

[Service]
Type=simple
ExecStart=/usr/bin/hyprpilot daemon --hidden
Restart=on-failure
RestartSec=5

ProtectSystem=strict

[Install]
WantedBy=default.target
